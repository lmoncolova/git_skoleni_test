--CREATE OR REPLACE PROCEDURE COPY_COLUMN_COMMENTS(TABLE_TO_BE_COMMENTED IN VARCHAR2,
--                                                 TABLE_WITH_COMMENTS   IN VARCHAR2) IS
  
  -- cilem je nastaveni komentaru pro SLOUPCE jedne tabulky dle komentaru v jine tabulce
  -- procedura vygeneruje komentar pro kazdy sloupec, ktery existuje v obidvoch tabulich
  -- problem je, ze procedura nevidi do tabulky dba_col_comments - musim si ji explicitne nagrantovat. Proto nechavam skript.
  
DECLARE
  
  tablename_jez VARCHAR2(30) := 'OVERDRAFT';      -- OVERDRAFT_BALANCE_PD
  tablename_dwh VARCHAR2(30) := 'F_OVERDRAFT_AT'; -- F_OVERDRAFT_BALANCE_PD


  CURSOR bleh IS
    SELECT ('COMMENT ON COLUMN ' || nazev_aktualniho_hriste || '.' || jz.TABLE_NAME || '.' ||
           jz.COLUMN_NAME || ' IS ' || '''' || dwh.COMMENTS || '''' || ';') AS COMMENT_STRING
      FROM (SELECT * FROM USER_COL_COMMENTS a WHERE A.TABLE_NAME = tablename_jez) jz
      JOIN (SELECT * FROM DBA_COL_COMMENTS a WHERE A.TABLE_NAME = tablename_dwh) dwh
        ON jz.column_name = dwh.COLUMN_NAME
     ;

  text DBA_COL_COMMENTS.comments%TYPE;

BEGIN
  
  open bleh;
  loop
    fetch bleh into text;
    exit when bleh%notfound;
      dbms_output.put_line(text);
  end loop;
  close bleh;  

END;
